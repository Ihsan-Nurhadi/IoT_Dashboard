# ==========================================
# KONFIGURASI MQTT BROKER
# ==========================================
BROKER_HOST=emqx.nayakanms.com
BROKER_PORT=1884
MQTT_USER=nyk_ws
MQTT_PASS=ws

# ==========================================
# PARAMETER PENGIRIMAN DATA
# ==========================================
INTERVAL_SEC=5
HEARTBEAT_SEC=60
TOWER_HEIGHT_MM=42000
TILT_TOL_DEG=0.286
SWAY_TOL_MM=210.0
PROJECT=vertical
FW_VERSION=0.4.0
LOCAL_IP=192.168.1.150

# ==========================================
# MODE RUNNER (OPSIONAL)
# ==========================================
# 1. Mode Default (Kosongkan keduanya):
#    Akan otomatis menjalankan ke-11 device dari devices.json
#
# 2. Mode Single Device:
#    Isi CHIP_ID dan MAC_ADDRESS jika ingin menjalankan 1 container untuk 1 device khusus
# CHIP_ID=E32_VER_SWADAYA
# MAC_ADDRESS=3A:0E:4C:1E:80:6E
#
# 3. Mode Filter Device:
#    Jalankan hanya beberapa device tertentu (pisahkan koma)
# TARGET_CHIPS=E32_VER_SWADAYA,E32_VER_PEDURENAN

# ==========================================
# MITRATEL MONITOR SERVICE (MQTT & GSHEETS)
# ==========================================
# Menggunakan prefix MITRATEL_ agar tidak bentrok dengan MQTT_USER utama NMS
MITRATEL_MQTT_BROKER=emqx.nayakanms.com
MITRATEL_MQTT_PORT=1884
MITRATEL_MQTT_USER=dmtver_jabo
MITRATEL_MQTT_PASSWORD=jabo123
MITRATEL_LISTEN_WINDOW_SECONDS=300
GSHEET_WEBHOOK_URL="https://script.google.com/macros/s/AKfycb.../exec"

# ==========================================
# AUTO DEGRADE WATCHER (24/7 VPS SERVICE)
# ==========================================
# Kredensial Login Akun Dashboard Nayaka / MaiView
DEGRADE_USERNAME=admin
DEGRADE_PASSWORD=ganti_dengan_password_anda

# Endpoint Login & Public API
DEGRADE_LOGIN_URL=https://admin.nayakanms.com/api/auth/login
DEGRADE_PUBLIC_API_URL=https://api.maiviewmitratel.id/v1/sites
DEGRADE_PUBLIC_API_KEY=nms_live_0c05c2b6_d09b6897332bcc9fde952de761b6e15ba8cb9366817b22231ca126a2b933106a

# Interval Pengecekan status site (detik)
DEGRADE_CHECK_INTERVAL=1800

# Interval pengiriman ulang degrade berkala jika site masih offline (menit)
DEGRADE_RE_DEGRADE_MINUTES=15

# Alasan Degrade
DEGRADE_REASON=-

# Opsional: Override endpoint Degrade jika berbeda
# DEGRADE_URL_OVERRIDE=https://admin.nayakanms.com/api/admin/sites/{site_id}/degrade

# Opsional: Batasi hanya site tertentu (UUID atau Site Code dipisah koma)
# DEGRADE_TARGET_SITES=PLG-03-128,PNJ-09-036


