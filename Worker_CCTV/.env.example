# ==========================================
# Worker CCTV - RTSP & ONVIF API Gateway
# Konfigurasi Koneksi Kamera & Gateway Service
# ==========================================

# Port listening untuk Worker API Gateway di VPS
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3001

# Kredensial & Alamat IP Kamera (diakses melalui VPN di VPS)
CAMERA_HOST=10.10.1.17
CAMERA_USER=NMSIOTYOGYA1
CAMERA_PASS=Nayaka2025

# RTSP Stream Config
RTSP_PORT=554
RTSP_PATH=/stream1
# Full URL override jika diperlukan (default: rtsp://CAMERA_USER:CAMERA_PASS@CAMERA_HOST:RTSP_PORT/stream1)
# RTSP_URL=rtsp://NMSIOTYOGYA1:Nayaka2025@10.10.1.17:554/stream1

# ONVIF Config
ONVIF_PORT=2020
ONVIF_PATH=/onfiv/device_service

# Stream Optimization
TARGET_FPS=20
STREAM_WIDTH=1280
STREAM_QUALITY=75
RTSP_TRANSPORT=tcp
